forks/
jars/
# results/: track run writeups, repro scripts and diff evidence; keep bulk probe
# dumps untracked. The dumps total 2.2 GB and one sweep.jsonl is 340 MB, above
# GitHub's 100 MB per-file limit. The `!results/**/` line un-ignores the
# directories; without it the extension rules below cannot re-include anything.
results/**
!results/**/
!results/**/*.md
!results/**/*.csv
!results/**/*.txt
!results/**/*.sh
!results/**/*.py
# Machine output that carries a whitelisted extension. Raw per-block extractions
# are named after the .json they came from; the harness dispatch log is a .txt.
# These rules follow the negations above, because the last match decides.
results/**/*.json.*
results/**/*-progress.txt
# Per-block chunk extractions (-Dprobe.dump). Hundreds of KB each and regenerable
# from the command recorded in the run's README; the finding they support belongs
# in the README, the raw block listing does not.
results/**/*.dump.txt
*/build/
*/.gradle/
*/gtnhShared/
*/run/
docs/HANDOFF*
.env
scripts/__pycache__/
seedlib/**/*.tar.gz
**/__pycache__
# Compiled Java. The gradle builds land in */build/, already ignored above, but seedsearch/rwg-analytic
# is built by hand with javac -d out, so its output needs a rule of its own. Kept as a blanket *.class
# rather than naming that one directory: nothing here has ever tracked a .class, and the next
# hand-built scratch tool should not have to remember to come back and add a line.
*.class

# Build-generated copies of shared/chest-nohooks.json. scripts/build-jar.sh writes one into each jar's
# resources on every build; the canonical file is shared/chest-nohooks.json. Tracking the copies would
# let them drift from it in review, which is the exact failure the single-copy arrangement prevents.
fix-build/src/main/resources/chest-nohooks.json
probe-build/src/main/resources/chest-nohooks.json

# Route map distributables: build artifacts, 31 MB of vendored interpreter and wheels.
# Built by scripts/build-routemap-zip.py and attached to releases by CI, never committed.
dist/
